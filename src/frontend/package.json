    "@vitejs/plugin-vue": "^6.0.8",
    "@volar/language-server": "^2.4.28",
    "@vue/language-server": "^3.3.11",
    "@vueuse/core": "^14.4.0",
    "autoprefixer": "^10.5.4",
    "axios": "^1.20.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "file-saver": "^2.0.5",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue": "^3.5.42",

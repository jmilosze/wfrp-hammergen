{
  "name": "hammergen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build_gcp_production": "vue-tsc && vite build --mode gcp_production",
    "build_gcp_staging": "vue-tsc && vite build --mode gcp_staging",
    "build_container_production": "vue-tsc && vite build --mode container_production",
    "build_container_staging": "vue-tsc && vite build --mode --mode container_staging",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "vue-tsc && eslint src"
  },
  "dependencies": {
    "@eslint/js": "^9.39.5",
    "@iconify/vue": "^5.0.1",
    "@tailwindcss/vite": "^4.3.3",

{
  "name": "hammergen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build_gcp_production": "vue-tsc && vite build --mode gcp_production",
    "build_gcp_staging": "vue-tsc && vite build --mode gcp_staging",
    "build_container_production": "vue-tsc && vite build --mode container_production",
    "build_container_staging": "vue-tsc && vite build --mode container_staging",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "vue-tsc && eslint src"
  },
  "dependencies": {
    "@fontsource-variable/alegreya": "^5.3.0",
    "@iconify/vue": "^5.0.4",
    "@vueuse/core": "^15.0.0",
    "@vueuse/router": "^15.0.0",
    "axios": "^1.20.0",
    "file-saver": "^2.0.5",
    "recaptcha-v3": "^1.11.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/file-saver": "^2.0.7",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
